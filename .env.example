# Copy to .env and adjust (all optional).
TB_ADMIN_USER=admin
TB_ADMIN_PASSWORD=change-me
# Leave empty to have a key generated once into data/.secret_key. If you set one,
# keep it stable (openssl rand -hex 32) — it encrypts stored passwords.
TB_SECRET_KEY=
TB_TASMOTA_USER=admin
TB_TASMOTA_PASSWORD=
PUID=1000
PGID=1000
TZ=Europe/Berlin
